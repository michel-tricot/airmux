worker_processes auto;
pid /tmp/airmux-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  client_body_temp_path /tmp/airmux-client;
  proxy_temp_path /tmp/airmux-proxy;
  fastcgi_temp_path /tmp/airmux-fastcgi;
  uwsgi_temp_path /tmp/airmux-uwsgi;
  scgi_temp_path /tmp/airmux-scgi;
  resolver ${NGINX_RESOLVER} valid=5s ipv6=off;
  map $upstream_http_cache_control $api_cache_control {
    default "no-store";
    "no-store, no-transform" "no-store, no-transform";
  }
  map $uri $private_cache_control {
    default "";
    ~^/(api|inf)/ $api_cache_control;
  }
  server {
    listen 8080;
    root ${AIRMUX_CONSOLE_ROOT};
    client_max_body_size 32m;
    set $control_plane "${CONTROL_PLANE_UPSTREAM}";
    set $data_plane "${DATA_PLANE_UPSTREAM}";
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $private_cache_control always;
    proxy_hide_header Cache-Control;
    proxy_hide_header X-Content-Type-Options;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_connect_timeout 2s;
    location = /healthz { proxy_pass http://$control_plane/healthz; }
    location = /readyz { proxy_pass http://$data_plane; }
    location /api/ { proxy_pass http://$control_plane; }
    location /inf/ {
      proxy_pass http://$data_plane;
      proxy_http_version 1.1;
      proxy_buffering off;
      proxy_read_timeout 300s;
    }
    location / { try_files $uri /index.html; }
  }
}
