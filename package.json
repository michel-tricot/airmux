{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/console",
      "lib/*"
    ],
    "catalog": {
      "@replit/vite-plugin-cartographer": "^0.5.21",
      "@replit/vite-plugin-dev-banner": "^0.1.1",
      "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
      "@tailwindcss/vite": "^4.1.14",
      "@tanstack/react-query": "^5.90.21",
      "@types/node": "^25.3.3",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.545.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.14",
      "tsx": "^4.21.0",
      "vite": "^7.3.2",
      "wouter": "^3.3.5",
      "zod": "^3.25.76"
    }
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock pnpm-lock.yaml; case \"$npm_config_user_agent\" in bun/*) ;; *) echo \"Use bun instead\" >&2; exit 1 ;; esac'",
    "dev": "bun run --filter '@workspace/gateway-console' dev",
    "serve": "bun run --filter '@workspace/gateway-console' serve",
    "build": "bun run typecheck && bun run --filter '@workspace/gateway-console' build",
    "codegen": "bun run --cwd lib/api-spec codegen",
    "typecheck:libs": "tsc --build",
    "typecheck": "bun run typecheck:libs && bun run --filter '@workspace/gateway-console' typecheck"
  },
  "private": true,
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "jsdom": "^30.0.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "msw",
    "unrs-resolver"
  ]
}
