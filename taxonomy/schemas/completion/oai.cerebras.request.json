{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/components_schemas_ChatCompletionRequest",
  "$defs": {
    "components_schemas_AssistantMessageRequest": {
      "additionalProperties": false,
      "description": "A message request from an assistant.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/components_schemas_TextContent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/components_schemas_TextContent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "role": {
          "const": "assistant",
          "default": "assistant",
          "title": "Role",
          "type": "string"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/components_schemas_AssistantToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "title": "AssistantMessageRequest",
      "type": "object"
    },
    "components_schemas_AssistantToolCall": {
      "additionalProperties": false,
      "description": "A tool call for an assistant.",
      "properties": {
        "function": {
          "$ref": "#/$defs/components_schemas_AssistantToolCallFunction"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "type": {
          "const": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "title": "AssistantToolCall",
      "type": "object"
    },
    "components_schemas_AssistantToolCallFunction": {
      "additionalProperties": false,
      "description": "A function call for an assistant tool.",
      "properties": {
        "arguments": {
          "title": "Arguments",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "AssistantToolCallFunction",
      "type": "object"
    },
    "components_schemas_ChatCompletionRequest": {
      "additionalProperties": false,
      "description": "Generic base class for chat completion requests.",
      "examples": [
        {
          "max_completion_tokens": -1,
          "messages": [
            {
              "content": "You are a helpful assistant running on a CS-3 hardware at Cerebras Systems",
              "role": "system"
            },
            {
              "content": "What is Generative AI?",
              "role": "user"
            }
          ],
          "min_tokens": 1000,
          "model": "llama3.1-8b",
          "seed": 0,
          "stop_sequence": null,
          "stream": false,
          "temperature": 0,
          "top_p": 1
        }
      ],
      "properties": {
        "clear_thinking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When True, removes reasoning content from messages that appear before the latest user message.",
          "title": "Clear Thinking"
        },
        "disable_reasoning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Disables reasoning for reasoning models. If set to True, the model will not use any reasoning in its response.",
          "title": "Disable Reasoning"
        },
        "frequency_penalty": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0,
          "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",
          "title": "Frequency Penalty"
        },
        "logit_bias": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modify the likelihood of specified tokens appearing in the completion.\n\nAccepts a JSON object that maps tokens (specified by their token ID in the tokenizer) to an associated bias value from -100 to 100. Mathematically, the bias is added to the logits generated by the model prior to sampling. The exact effect will vary per model, but values between -1 and 1 should decrease or increase likelihood of selection; values like -100 or 100 should result in a ban or exclusive selection of the relevant token.",
          "title": "Logit Bias"
        },
        "logprobs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "Whether to return log probabilities of the output tokens or not. If true, returns the log probabilities of each output token returned in the content of message.",
          "title": "Logprobs"
        },
        "max_completion_tokens": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An upper bound for the number of tokens that can be generated for a completion, including visible output tokens and reasoning tokens.",
          "title": "Max Completion Tokens"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The maximum number of tokens that can be generated in the chat completion. The total length of input tokens and generated tokens is limited by the model's context length. This value is now deprecated in favor of max_completion_tokens.",
          "title": "Max Tokens"
        },
        "messages": {
          "items": {
            "discriminator": {
              "mapping": {
                "assistant": "#/components/schemas/AssistantMessageRequest",
                "developer": "#/components/schemas/DeveloperMessageRequest",
                "system": "#/components/schemas/SystemMessageRequest",
                "tool": "#/components/schemas/ToolMessageRequest",
                "user": "#/components/schemas/UserMessageRequest"
              },
              "propertyName": "role"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/components_schemas_SystemMessageRequest"
              },
              {
                "$ref": "#/$defs/components_schemas_DeveloperMessageRequest"
              },
              {
                "$ref": "#/$defs/components_schemas_UserMessageRequest"
              },
              {
                "$ref": "#/$defs/components_schemas_AssistantMessageRequest"
              },
              {
                "$ref": "#/$defs/components_schemas_ToolMessageRequest"
              }
            ]
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "min_completion_tokens": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The minimum number of tokens to generate for a completion. If not specified or set to 0, the model will generate as many tokens as it deems necessary. Setting to -1 sets to max sequence length.",
          "title": "Min Completion Tokens"
        },
        "min_tokens": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The minimum number of tokens to generate for a completion. If not specified or set to 0, the model will generate as many tokens as it deems necessary. Setting to -1 sets to max sequence length.",
          "title": "Min Tokens"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model-specific parameters. The accepted keys and values are defined per-model by the model's ``model_parameters`` schema. The schema is used downstream to validate the contents of this field. Unsupported for models that declare none.",
          "title": "Model Parameters"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "How many chat completion choices to generate for each input message. Note that you will be charged based on the number of generated tokens across all of the choices. Keep n as 1 to minimize costs.",
          "title": "N"
        },
        "parallel_tool_calls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Parallel Tool Calls"
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_Prediction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Configuration for a Predicted Output, which can greatly improve response times when large parts of the model response are known ahead of time. This is most common when regenerating a file with only minor changes to most of the content."
        },
        "presence_penalty": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0,
          "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",
          "title": "Presence Penalty"
        },
        "prompt_cache_key": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An optional opaque string. The requests with the same prompt cache key would highly likely share the same prompt prefixes. Examples would be IDs of chat conversations, IDs of users, the hashes of system prompts, etc.",
          "title": "Prompt Cache Key"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constrains effort on reasoning for reasoning models. Currently supported values are none, low, medium, and high. Reducing reasoning effort can result in faster responses and fewer tokens used on reasoning in a response. If set to None, the model will use the default reasoning effort for the model. If set to 'none', the model will not reason"
        },
        "reasoning_format": {
          "$ref": "#/$defs/components_schemas_ReasoningFormat",
          "default": "none",
          "description": "Determines how reasoning is returned in the response. If set to `parsed`, the reasoning will be returned in the `reasoning` field of the response message as a string. If set to `raw`, the reasoning will be returned in the `content` field of the response message with special tokens. If set to `hidden`, the reasoning will not be returned in the response. If set to `none`, the model's default behavior will be used. If set to `text_parsed`, the reasoning will be returned in the `reasoning` field of the response message as a string, similar to `parsed`, but logprobs will not be separated into `reasoning_logprobs` and `logprobs`."
        },
        "response_format": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "json_object": "#/components/schemas/ResponseFormatJSONObject",
                  "json_schema": "#/components/schemas/ResponseFormatJSONSchema",
                  "text": "#/components/schemas/ResponseFormatText"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/components_schemas_ResponseFormatText"
                },
                {
                  "$ref": "#/$defs/components_schemas_ResponseFormatJSONObject"
                },
                {
                  "$ref": "#/$defs/components_schemas_ResponseFormatJSONSchema"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Format"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If specified, our system will make a best effort to sample deterministically, such that repeated requests with the same `seed` and parameters should return the same result. Determinism is not guaranteed.",
          "title": "Seed"
        },
        "service_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_ServiceTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 4 sequences where the API will stop generating further tokens. The returned text will not contain the stop sequence.",
          "title": "Stop"
        },
        "stream": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "title": "Stream"
        },
        "stream_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_StreamOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1.0,
          "description": "What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. We generally recommend altering this or `top_p` but not both.",
          "title": "Temperature"
        },
        "tool_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_ToolChoice"
            },
            {
              "$ref": "#/$defs/components_schemas_ChoiceObject"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Choice"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/components_schemas_Tool"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "top_logprobs": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An integer between 0 and 20 specifying the number of most likely tokens to return at each token position, each with an associated log probability. logprobs must be set to true if this parameter is used.",
          "title": "Top Logprobs"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1.0,
          "description": "An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We generally recommend altering this or `temperature` but not both.",
          "title": "Top P"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A unique identifier representing your end-user, which can help Cerebras to monitor and detect abuse. ",
          "title": "User"
        }
      },
      "required": [
        "model",
        "messages"
      ],
      "title": "ChatCompletionRequest",
      "type": "object"
    },
    "components_schemas_ChoiceObject": {
      "additionalProperties": false,
      "description": "A choice object.",
      "properties": {
        "function": {
          "$ref": "#/$defs/components_schemas_ChoiceObjectFunction"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "function"
      ],
      "title": "ChoiceObject",
      "type": "object"
    },
    "components_schemas_ChoiceObjectFunction": {
      "additionalProperties": false,
      "description": "A function for a choice object.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ChoiceObjectFunction",
      "type": "object"
    },
    "components_schemas_DeveloperMessageRequest": {
      "additionalProperties": false,
      "description": "A message request from the developer:\nCurrently only for openai models, where they are functionally the same as system",
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "image": "#/components/schemas/ImageContent",
                    "image_url": "#/components/schemas/ImageUrlContent",
                    "text": "#/components/schemas/TextContent"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/components_schemas_TextContent"
                  },
                  {
                    "$ref": "#/$defs/components_schemas_ImageUrlContent"
                  },
                  {
                    "$ref": "#/$defs/components_schemas_ImageContent"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "const": "developer",
          "default": "developer",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "DeveloperMessageRequest",
      "type": "object"
    },
    "components_schemas_FunctionObject": {
      "additionalProperties": false,
      "description": "A function object.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/components_schemas_Parameters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strict": {
          "default": false,
          "title": "Strict",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "FunctionObject",
      "type": "object"
    },
    "components_schemas_ImageContent": {
      "additionalProperties": false,
      "description": "Image URL content for a message.",
      "properties": {
        "image": {
          "title": "Image",
          "type": "string"
        },
        "type": {
          "const": "image",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "image"
      ],
      "title": "ImageContent",
      "type": "object"
    },
    "components_schemas_ImageUrl": {
      "additionalProperties": false,
      "description": "Image URL",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "auto",
          "title": "Detail"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImageUrl",
      "type": "object"
    },
    "components_schemas_ImageUrlContent": {
      "additionalProperties": false,
      "description": "Image URL content for a message.",
      "properties": {
        "image_url": {
          "$ref": "#/$defs/components_schemas_ImageUrl"
        },
        "type": {
          "const": "image_url",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "image_url"
      ],
      "title": "ImageUrlContent",
      "type": "object"
    },
    "components_schemas_JSONSchema": {
      "additionalProperties": false,
      "description": "A JSON Schema object.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema"
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict"
        }
      },
      "required": [
        "name"
      ],
      "title": "JSONSchema",
      "type": "object"
    },
    "components_schemas_Parameters": {
      "additionalProperties": true,
      "description": "Represents the parameters a function accepts.\nThis model is designed to be flexible to accommodate any JSON Schema.\nThe key-value pairs you provide will define the parameters.",
      "title": "Parameters",
      "type": "object"
    },
    "components_schemas_Prediction": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/components_schemas_TextContent"
              },
              "type": "array"
            }
          ],
          "title": "Content"
        },
        "type": {
          "const": "content",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "components_schemas_ReasoningEffort": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "components_schemas_ReasoningFormat": {
      "enum": [
        "none",
        "parsed",
        "text_parsed",
        "raw",
        "hidden"
      ],
      "title": "ReasoningFormat",
      "type": "string"
    },
    "components_schemas_ResponseFormatJSONObject": {
      "additionalProperties": false,
      "description": "A response format for a JSON object.",
      "properties": {
        "type": {
          "const": "json_object",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ResponseFormatJSONObject",
      "type": "object"
    },
    "components_schemas_ResponseFormatJSONSchema": {
      "additionalProperties": false,
      "description": "A response format for a JSON schema.",
      "properties": {
        "json_schema": {
          "$ref": "#/$defs/components_schemas_JSONSchema"
        },
        "type": {
          "const": "json_schema",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "json_schema",
        "type"
      ],
