[importlinter]
root_packages =
    gw_contract
    control_plane
    data_plane
include_external_packages = True

[importlinter:contract:data-plane-isolation]
name = data plane never imports control plane or database machinery
type = forbidden
source_modules =
    data_plane
forbidden_modules =
    control_plane
    sqlalchemy
    sqlmodel
    asyncpg
    psycopg
    alembic
    fastapi
