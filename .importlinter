[importlinter]
root_packages =
    contract
    control_plane
    data_plane
    provider_parity
include_external_packages = True

[importlinter:contract:data-plane-isolation]
name = data plane imports no control plane or database machinery except the insecure vault
type = forbidden
source_modules =
    data_plane
forbidden_modules =
    control_plane
    sqlalchemy
    sqlmodel
    asyncpg
    psycopg
    alembic
    fastapi
ignore_imports =
    contract.secrets.insecure_database -> asyncpg

[importlinter:contract:provider-parity-is-black-box]
name = provider parity reaches the gateway through public HTTP only
type = forbidden
source_modules =
    provider_parity
forbidden_modules =
    control_plane
    data_plane
