modules = ["bash", "web", "postgresql-16", "python-base-3.13", "nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["bun", "pm", "cache", "rm"]
env = { "CI" = "true" }

[workflows]
runButton = "apps/console: web"

[[workflows.workflow]]
name = "backend: control plane"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./scripts/replit-backend.sh"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
