modules = ["bash", "web", "python-base-3.13", "nodejs-24", "bun-1.3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["bun", "pm", "cache", "rm"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "apps/console: web"

[[workflows.workflow]]
name = "backend: control plane"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./scripts/replit-backend.sh"
waitForPort = 8001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "console-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/console && bun run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
