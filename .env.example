# Secrets only. Everything else lives in airllm.yml, which references
# these via env: entries. `uv run airllmcp keygen` writes the key pair; the
# tokens are minted through the API or the CLI and pasted in.

OPENAI_API_KEY=sk-...

# GW_BUNDLE_SIGNING_KEY=  # control plane: signs bundles (base64 raw Ed25519)
# GW_BUNDLE_PUBLIC_KEY=   # data plane: verifies bundles
# GW_INSTANCE_KEY=        # instance API bearer (sk-inst-...)
# GW_DATAPLANE_TOKEN=     # data plane -> control plane bearer (sk-mgmt-...)
# AIRLLM_TOKEN=           # caller inference key (sk-inf-...)
