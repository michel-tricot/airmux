OPENAI_API_KEY=sk-...

# `uv run airllm init` fills these in for you:
# GW_CONTROL_PLANE_URL=http://127.0.0.1:8000
# GW_CACHE_DIR=
# GW_SIGNING_KEY=        # control plane: signs bundles and API tokens (base64 raw Ed25519)
# GW_BUNDLE_PUBLIC_KEY=  # data plane: verifies bundles and API tokens
# GW_ADMIN_TOKEN=        # admin API bearer
# GW_DP_TOKEN=           # data plane -> control plane bearer
# GW_POLL_INTERVAL_S=5

# `uv run airllm bootstrap` (or seed) fills this in:
# AIRLLM_TOKEN=
